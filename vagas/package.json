{
  "name": "caca-vagas",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Caça-vagas + currículo adaptado. Busca vagas (portais, ATS e LinkedIn via Apify), pontua contra o seu perfil e adapta o currículo acima do corte.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/onboarding.mjs --abrir",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "coletar": "node scripts/executar.mjs rodada",
    "rodada": "node scripts/executar.mjs rodada",
    "test": "node --test --test-concurrency=1",
    "instrucoes": "node scripts/instrucoes.mjs",
    "test:rede": "VAGAS_REDE=1 node --test test/integracao.test.js",
    "enriquecer": "node scripts/executar.mjs enriquecer",
    "pendentes": "node scripts/pendentes.mjs",
    "descobrir": "node scripts/descobrir-empresas.mjs",
    "validar:respostas": "node scripts/validar-respostas.mjs",
    "test:curriculo": "python3 -m unittest discover -s ../Skills/adapt-resume/tests -p \"test_*.py\"",
    "apify": "node scripts/executar.mjs apify",
    "checar:publico": "node scripts/checar-publico.mjs",
    "onboarding": "node scripts/onboarding.mjs",
    "quadro": "node scripts/quadro.mjs",
    "operacao": "node scripts/operacao.mjs",
    "verificar:envio": "node scripts/verificar-envio.mjs",
    "verificar:versao": "node scripts/verificar-versao.mjs",
    "fontes": "node scripts/fontes.mjs",
    "verificar:fontes": "node scripts/verificar-fontes.mjs",
    "sincronizar:fontes": "node scripts/sincronizar-fontes.mjs",
    "registrar:respostas": "node scripts/registrar-respostas.mjs",
    "atualizar": "node scripts/atualizar.mjs",
    "estado": "node scripts/estado.mjs"
  }
}
